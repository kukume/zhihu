{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zhihu",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  "limits": {
    "cpu_ms": 60000
  }
}
